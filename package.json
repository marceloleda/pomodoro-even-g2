{
  "name": "pomodoro-g2",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "check:text": "node --experimental-strip-types --no-warnings scripts/check-text.ts",
    "preview": "vite preview",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173",
    "pack": "npm run check:text && npm run build && evenhub pack app.json dist -o pomodoro.ehpk --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@evenrealities/pretext": "0.1.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  }
}
